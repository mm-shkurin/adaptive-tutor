# Copy to infra/.env. Names are the ones the backend reads, plus the host ports
# compose publishes. Postgres and Redis hostnames inside DATABASE_URL and
# REDIS_URL are the compose service names, not localhost.

POSTGRES_USER=absolute
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adaptive_tutor
POSTGRES_HOST_PORT=5433

REDIS_HOST_PORT=6380

BACKEND_HOST_PORT=8010
GATEWAY_HOST_PORT=80

DATABASE_URL=postgresql+asyncpg://absolute:change-me@postgres:5432/adaptive_tutor
REDIS_URL=redis://redis:6379/0

OAUTH_PROVIDER=yandex
JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_REFRESH_SECRET=change-me-refresh-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200
OAUTH_FRONTEND_CALLBACK_URL=http://localhost/auth/callback
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost/api/v1/auth/oauth/yandex/callback
