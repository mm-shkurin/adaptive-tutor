{
  "_comment": "Project binding for AdaptiveTutor. Clean Architecture: domain ← usecase ← adapters ← application. Dependency flow is strictly inward.",
  "layers": {
    "back": {
      "root": "backend",
      "kind": "service",
      "code": [
        "backend/domain",
        "backend/usecase",
        "backend/adapters",
        "backend/application",
        "backend/tests"
      ],
      "src": [
        "*.py"
      ],
      "docs": [
        "backend/README.md"
      ],
      "config": [
        "backend/requirements.txt",
        "backend/alembic.ini"
      ],
      "styles": [],
      "changelog": [],
      "test_artifacts": [],
      "env_example": [
        "infra/.env.example",
        "backend/.env.example"
      ],
      "forbidden_imports": [
        {
          "name": "domain imports nothing from outer layers",
          "in": [
            "backend/domain"
          ],
          "regex": "^\\s*(from|import)\\s+.*(usecase|adapters|application)\\b|^\\s*(from|import)\\s+.*(fastapi|sqlalchemy)\\b"
        },
        {
          "name": "usecase imports only domain (not adapters/application/HTTP)",
          "in": [
            "backend/usecase"
          ],
          "regex": "^\\s*(from|import)\\s+.*(adapters|application)\\b|^\\s*(from|import)\\s+.*\\bfastapi\\b"
        },
        {
          "name": "adapters do not import application wiring",
          "in": [
            "backend/adapters"
          ],
          "regex": "^\\s*(from|import)\\s+.*\\bapplication\\b"
        }
      ],
      "release_ref": "origin/main",
      "artifact_remote": "origin"
    },
    "front": {
      "root": "frontend",
      "kind": "ui",
      "code": [
        "frontend/src"
      ],
      "src": [
        "*.js",
        "*.jsx",
        "*.ts",
        "*.tsx"
      ],
      "docs": [
        "frontend/README.md"
      ],
      "config": [
        "frontend/package.json"
      ],
      "styles": [
        "*.css"
      ],
      "changelog": [],
      "env_example": [
        "frontend/.env.example"
      ],
      "forbidden_imports": [],
      "release_ref": "origin/main",
      "artifact_remote": "origin",
      "test_artifacts": []
    }
  },
  "shared_roots": [
    "infra",
    "acceptance"
  ],
  "main_branch": "main",
  "style_token_files": "styles/(palette|tokens[\\w-]*|theme[\\w-]*)\\.css|index\\.css",
  "state_libraries": "zustand|@reduxjs/toolkit|mobx|@tanstack/react-query|\\\"swr\\\"|jotai|recoil|valtio",
  "file_line_limit": 200,
  "commit_file_limit": 40,
  "changelog_commit_limit": 25,
  "artifact_host": "github.com",
  "test_artifacts": [
    "ProductSpecification"
  ],
  "branch_pattern": "^(features?|feat|fix|hotfix|release|chore|task)/[\\w.-]+$"
}
